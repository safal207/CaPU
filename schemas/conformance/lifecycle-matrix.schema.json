{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capu.dev/schemas/conformance/lifecycle-matrix.v1.json",
  "title": "CaPU lifecycle conformance matrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "scenarios"],
  "properties": {
    "schema": { "const": "capu.conformance.lifecycle.v1" },
    "scenarios": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "events", "expected"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "events": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "GATE_PERMIT",
                "GATE_REJECT_INVALID",
                "GATE_REJECT_POLICY",
                "MISSING_PARENT",
                "HOLD",
                "PARENT_AVAILABLE",
                "MATURE",
                "COMMIT_OK",
                "COMMIT_FAIL",
                "EXPIRE",
                "EXECUTE"
              ]
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["decision_code", "execute_count"],
            "properties": {
              "decision_code": { "type": "string", "minLength": 1 },
              "execute_count": { "type": "integer", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    }
  }
}
