[options]
mode cover
depth 20

[engines]
smtbmc --unroll z3 -- --noincr

[script]
read -formal capu_store_buffer.sv capu_ctag_validator.sv capu_seal_controller.sv capu_causal_head_controller.sv capu_vcml_store_buffer.sv capu_replay_recovery_guard.sv capu_vcml_store_buffer_v10.sv capu_checkpoint_freshness_guard.sv capu_vcml_store_buffer_v11.sv capu_checkpoint_commit_controller.sv capu_vcml_store_buffer_v12.sv capu_checkpoint_content_binding_v13.sv capu_checkpoint_content_binding_v13_formal.sv
prep -top capu_checkpoint_content_binding_v13_formal

